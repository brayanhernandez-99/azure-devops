# Download image from ECR
FROM --platform=linux/amd64 861262569826.dkr.ecr.us-east-1.amazonaws.com/node-alpine:latest

# Workspace application
WORKDIR /usr/src/app

# Arguments
ARG PORT=8080

# Usar HTTP mirror para bootstrap de certificados (SSL verify falla sin ca-certificates)
RUN sed -i 's|https://dl-cdn.alpinelinux.org|http://dl-cdn.alpinelinux.org|g' /etc/apk/repositories && \
    apk add --no-cache openssl ca-certificates && \
    sed -i 's|http://dl-cdn.alpinelinux.org|https://dl-cdn.alpinelinux.org|g' /etc/apk/repositories

# Descargar e importar el certificado de sivical.supersalud.gov.co
RUN echo | openssl s_client \
    -connect sivical.supersalud.gov.co:443 \
    -servername sivical.supersalud.gov.co \
    | openssl x509 -outform PEM \
    > /usr/local/share/ca-certificates/supersalud.crt 2>/dev/null;

# Descargar e importar el certificado de b2csupersalud.b2clogin.com
RUN echo | openssl s_client \
    -connect b2csupersalud.b2clogin.com:443 \
    -servername b2csupersalud.b2clogin.com \
    | openssl x509 -outform PEM \
    > /usr/local/share/ca-certificates/b2csupersalud.crt 2>/dev/null;

# Actualizar el almacén de certificados de confianza
RUN update-ca-certificates || true

# Copy files npm to docker
COPY package.json .
COPY .npmrc /root/.

# Install package microservice
RUN npm i

# Copy project in docker
COPY . .

# Uninstall minimal packages for docker image
RUN rm -rf .npmrc && \
    rm -f THIRD-PARTY-LICENSES.txt \
    rm -f LICENSE

ENV OPENSSL_CONF=/etc/ssl/

# Start the application
EXPOSE ${PORT}
ENTRYPOINT [ "npm", "run", "execute" ]